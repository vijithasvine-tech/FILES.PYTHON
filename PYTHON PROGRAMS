    print("Invalid membership status")
else:
    if amount >= 500:
        if distance <= 5:
            delivery = 0
        else:
            delivery = 40
    else:
        if membership == "yes":
            delivery = 10 if distance <= 5 else 20
        else:
            delivery = 30 if distance <= 5 else 40

    total = amount + delivery
    print(f"Delivery charge: ₹{delivery:.2f}")
    print(f"Total amount: ₹{total:.2f}")

